{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vivoh-earth",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "vivoh.earth",
      "custom_domain": true
    },
    {
      "pattern": "www.vivoh.earth",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "RTSPSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RTSPSession"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
