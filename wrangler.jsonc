/**
 * Vivoh.Earth — MoQ broadcast/watch frontend + worker.
 *
 * Ported from Wallflower (2026-08-17). The client, Worker, schema and UX are Wallflower's;
 * what differs, deliberately, is authentication: OAuth is ON here and is the ONLY publisher
 * door. See the OAUTH section in src/worker/index.ts.
 *
 * Relay backend: moq.pro (Mode A). MOQ_PRO_JWK (preferred) or MOQ_PRO_K is set as a secret,
 * so moqProAssign() returns first and every broadcast goes through cdn.moq.pro with a
 * per-broadcast token this Worker mints. The FLEET_* vars below are the DORMANT alternative
 * path — they are read only when no MOQ_PRO_* secret is set. Moving to the tinymoq
 * broker/fleet is a secret change plus these vars, not a code change.
 *
 * The signing key is `Vivoh-Earth` (EdDSA, kid RaYsFGNb-ZyeTIflp1EME9SOBW383x0LiflXg9pNfg0),
 * generated 27 Aug 2026 for this deployment ALONE. Deliberately not Wallflower's key: one key
 * across both products means a compromise of either Worker forges tokens for the other.
 *
 * MOQ_PRO_ROOT is unset, so the path namespace is "erik" — the same one Wallflower uses. That
 * is an accepted risk, not an oversight. Stream ids are 5 chars of [a-z0-9] (60.5M) and
 * generateStreamId() only checks THIS deployment's D1, so nothing prevents a cross-product
 * collision; it is simply ~1e-6 at current volume. And a token minted under a shared root
 * grants relay access to CIPHERTEXT only — the content key is derived from the share link's
 * fragment and never reaches any Worker. Set MOQ_PRO_ROOT if either product gains real volume.
 *
 *   wrangler secret put MOQ_PRO_JWK          (moq.pro asymmetric signing key)
 *   wrangler secret put GOOGLE_CLIENT_ID     + GOOGLE_CLIENT_SECRET
 *   wrangler secret put MICROSOFT_CLIENT_ID  + MICROSOFT_CLIENT_SECRET
 *   wrangler secret put DISCORD_CLIENT_ID    + DISCORD_CLIENT_SECRET
 *   wrangler secret put SESSION_SECRET       (signs the session cookie)
 *   wrangler secret put ADMIN_PASSWORD       (bearer for /api/admin/*)
 *
 * Fail-closed: with no OAuth secrets set nobody can sign in, and with OAuth the only
 * publisher door that means nobody can publish. That is the intended failure direction.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vivoh-earth",
	"compatibility_date": "2025-01-01",
	"main": "src/worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Path 2 — BROKERED assign. Vivoh.Earth is a registered tenant; the Worker POSTs to the
	// assign URL with CDN_API_TOKEN as a Bearer and the operator picks the box. Media always
	// goes browser <-> box and never through the broker, so this endpoint is a control-plane
	// call on the way to going live, not a media path.
	//
	// NOTE the host: tinymoq.com, not moqcdn.net. The moqcdn.net value was inherited from
	// Wallflower's config and is the wrong broker for this tenant — the credential below is
	// issued against tinymoq.com and would simply be refused elsewhere.
	//
	// DORMANT while any MOQ_PRO_* secret is set: moqProAssign() returns first, so none of this
	// is reached. That is deliberate — it makes the flip (and the rollback) a secret change.
	"vars": {
		"FLEET_MODE": "brokered",
		"FLEET_ENDPOINT": "https://tinymoq.com/cdn/assign"
	},
	// Closes viewing sessions whose heartbeat stopped (see scheduled() in the worker). One
	// minute is the floor Cloudflare offers and the right one: the reaper's threshold is
	// SESSION_STALE_SECONDS, so a slower tick would leave dead sessions counted as live for
	// however long the gap is. Sessions are closed at their last heartbeat, not at reap time,
	// so a late tick costs accuracy in the live badge but never in the recorded duration.
	"triggers": {
		"crons": ["* * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vivoh-earth-db",
			"database_id": "d59f23d3-8f25-4b1b-aef3-bf3a93a2a58e"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOMS",
				"class_name": "ChatRoom"
			}
		]
	},
	// KEEP these tags as they are. This deployment has already applied v2 and v3; renumbering
	// to match Wallflower's single "v1" would make Cloudflare try to re-create a class that
	// already exists. The tag history is per-deployment state, not source you can port.
	"migrations": [
		{
			"tag": "v2",
			"deleted_classes": ["MoqRelay"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["ChatRoom"]
		}
	]
}
